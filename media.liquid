---
layout: layout.liquid
title: Media
permalink: /media/index.html
---
<div class='max-w-5xl mx-auto'>
  <h2 class='text-2xl font-bold mb-4 text-amber-900'>Media</h2>
  {% assign items = media %}
  {% if items and items.size > 0 %}
    <div class='grid gap-6 sm:grid-cols-2 lg:grid-cols-3'>
      {% for m in items %}
        <div class='bg-gradient-to-br from-amber-50/80 to-stone-100/80 backdrop-blur-sm rounded-lg p-4 shadow-lg border border-amber-200/50'>
          {% if m.type == 'youtube' %}
            <div class='relative w-full' style='padding-top: 56.25%'>
              <iframe
                class='absolute top-0 left-0 w-full h-full rounded-md'
                src='https://www.youtube.com/embed/{{ m.id | default: m.youtubeId }}'
                title='{{ m.title | escape }}'
                allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
                allowfullscreen
              ></iframe>
            </div>
          {% elsif m.type == 'image' %}
            <div class='overflow-hidden rounded-md'>
              <img
                src='{{ m.src }}'
                alt='{{ m.alt | default: m.title | escape }}'
                class='w-full h-auto block'
              >
            </div>
          {% endif %}
          {% if m.title %}
            <div class='mt-3 font-semibold text-amber-900'>{{ m.title }}</div>
          {% endif %}
          {% if m.description %}
            <div class='text-sm text-gray-700 mt-1'>{{ m.description }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class='bg-white/90 rounded-lg p-6 shadow border border-amber-200/50'>
      <p class='text-gray-700 mb-3'>No media has been added yet.</p>
      <p class='text-gray-600 text-sm'>
        Add items to <code>_data/media.json</code> in this format:
      </p>
      <pre class='mt-3 text-xs bg-stone-900/90 text-stone-100 p-3 rounded overflow-auto'><code>[
  {
    "type": "youtube",
    "id": "dQw4w9WgXcQ",
    "title": "Live at The Venue",
    "description": "A clip from a recent show."
  },
  {
    "type": "image",
    "src": "/assets/sample.jpg",
    "title": "Promo Shot",
    "alt": "Jeff Odell promo photograph",
    "description": "High‑res promotional photo."
  }
]</code></pre>
    </div>
  {% endif %}
</div>
