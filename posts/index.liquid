---
layout: layout.liquid
title: Blog
pagination:
  data: collections.postsByFileNameDesc
  size: 10
  alias: pagedPosts
permalink: "/posts/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber | plus: 1 }}/{% endif %}"
---
<div class='max-w-5xl mx-auto space-y-6'>
  <div class='bg-gradient-to-br from-amber-50/80 to-stone-100/80 backdrop-blur-sm rounded-lg p-6 shadow-lg border border-amber-200/50'>
    <h2 class='text-2xl font-bold mb-4 text-amber-900'>Blog Posts</h2>
    {% if pagedPosts and pagedPosts.length %}
      <ul class='space-y-3'>
        {% for post in pagedPosts %}
          <li class='hover:bg-amber-100/30 p-2 rounded transition-colors'>
            <a
              href='{{ post.url }}'
              class='text-amber-700 hover:text-amber-900 font-medium'
            >
              {{- post.data.title | default: post.fileSlug -}}
            </a>
            {% if post.date %}
              <small class='text-amber-600/70 ml-2'
                >({{ post.date | date: '%Y-%m-%d' }})</small
              >
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class='text-gray-600'>No posts were found.</p>
    {% endif %}
  </div>

  <nav class='flex items-center justify-between'>
    <div>
      {% if pagination.href.previous %}
        <a
          href='{{ pagination.href.previous }}'
          class='bg-amber-700/10 hover:bg-amber-700/20 backdrop-blur-sm text-amber-800 font-semibold px-4 py-2 rounded-lg transition-all duration-200 hover:scale-105 shadow-md border border-amber-200'
          rel='prev'
        >
          ← Newer
        </a>
      {% endif %}
    </div>
    <div class='text-sm text-gray-700'>
      Page {{ pagination.pageNumber | plus: 1 }} of
      {{ pagination.pages | size }}
    </div>
    <div>
      {% if pagination.href.next %}
        <a
          href='{{ pagination.href.next }}'
          class='bg-amber-700/10 hover:bg-amber-700/20 backdrop-blur-sm text-amber-800 font-semibold px-4 py-2 rounded-lg transition-all duration-200 hover:scale-105 shadow-md border border-amber-200'
          rel='next'
        >
          Older →
        </a>
      {% endif %}
    </div>
  </nav>

  {% assign totalPages = pagination.pages | size %}
  {% if totalPages > 1 %}
    <div class='text-center space-x-2'>
      {% for pageEntry in pagination.pages %}
        {% assign pageIndex = forloop.index %}
        {% assign pageUrl = pagination.hrefs[forloop.index0] %}
        <a
          href='{{ pageUrl }}'
          class='inline-block px-3 py-1 rounded border border-amber-200 shadow-sm transition-colors {% if forloop.index0 == pagination.pageNumber %}bg-amber-700/20 text-amber-900 font-semibold{% else %}bg-white/80 hover:bg-amber-50 text-amber-800{% endif %}'
        >
          {{ pageIndex }}
        </a>
      {% endfor %}
    </div>
  {% endif %}
</div>
