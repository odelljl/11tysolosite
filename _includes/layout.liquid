<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8'>
    <title>{{ title }}</title>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <script src='https://cdn.tailwindcss.com?plugins=typography'></script>
    <style>
      body {
        font-family: ui-sans-serif, system-ui, sans-serif;
        background-image: url('/assets/background.png');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
    </style>
  </head>
  <body class='text-gray-800 font-sans leading-relaxed'>
    <header class='bg-gradient-to-r from-amber-50 to-stone-100 shadow-lg py-6 px-6 mb-8'>
      <div class='max-w-7xl mx-auto flex items-center justify-between'>
        <h1 class='text-3xl font-bold tracking-tight text-amber-800 drop-shadow-sm'>
          {{ title }}
        </h1>
        <nav class='flex gap-4'>
          {% unless title == 'Home' %}
            <a
              href='/'
              class='bg-amber-700/10 hover:bg-amber-700/20 backdrop-blur-sm text-amber-800 font-semibold px-4 py-2 rounded-lg transition-all duration-200 hover:scale-105 shadow-md border border-amber-200'
            >
              Home
            </a>
          {% endunless %}
        </nav>
      </div>
    </header>

    <main class='w-full px-4 flex-grow'>
      <article class='bg-white/90 backdrop-blur-sm rounded-lg p-6 shadow-lg'>
        {{ content }}
      </article>
    </main>

    <footer class='mt-12 text-sm text-center text-gray-500 py-6 bg-white/80 backdrop-blur-sm'>
      &copy; {{ year }} Jeff Odell. All rights reserved.
    </footer>
  </body>
</html>
